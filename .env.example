# MoveRealm adapter
PORT=4173
HOST=127.0.0.1
CODEBUDDY_BASE_URL=http://127.0.0.1:8080
# Set this only when CodeBuddy HTTP authentication is enabled. Never expose it to the browser.
CODEBUDDY_PASSWORD=
# May be lowered for diagnostics; values above 45000 are capped so a repaired
# two-attempt run remains inside the browser's 96-second deadline.
CODEBUDDY_TIMEOUT_MS=45000

# Set to 1 only when intentionally rehearsing the deterministic fallback.
MOVEREALM_FORCE_FALLBACK=0

# Required for auditable local real-person trials. Copy the exact public release
# values after Pages succeeds (build-<run-id> and its full 40-character SHA).
VITE_BUILD_ID=
VITE_COMMIT_SHA=
